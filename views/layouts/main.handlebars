<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if pageTitle}}{{pageTitle}} - {{/if}}Online Auction</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    {{{_sections.css}}}

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        main {
            flex: 1;
        }
        
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
        }
        
        .footer {
            background-color: #212529;
            color: #fff;
            margin-top: auto;
        }
        
        .footer a {
            color: #adb5bd;
            text-decoration: none;
        }
        
        .footer a:hover {
            color: #fff;
        }

        /* Multi-level dropdown */
        .dropdown-menu .dropdown-toggle::after {
            vertical-align: middle;
            border-left: 0.3em solid;
            border-bottom: 0;
            border-top: 0;
        }
        
        .dropdown-menu .dropend .dropdown-toggle::after {
            margin-left: auto;
        }
        
        .dropdown-menu .dropdown-menu {
            left: 100%;
            top: 0;
            margin-left: 0.125rem;
        }
        
        @media (max-width: 991px) {
            .dropdown-menu .dropdown-menu {
                left: 0;
                margin-left: 1rem;
            }
        }
    </style>
</head>
<body>
    
    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-hammer"></i> AuctionHub
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">
                            <i class="bi bi-list-ul"></i> Auctions
                        </a>
                    </li>

                    <!-- Categories -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="/products/" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-grid"></i> Categories
                        </a>
                        <ul class="dropdown-menu">
                            {{#if categories}}
                                {{#each categories}}
                                <li class="dropdown dropend dropdown-submenu d-flex align-items-center">
                                    
                                    <!-- Link đi trang cấp 1 -->
                                    <a class="dropdown-item flex-grow-1" href="/products?category={{this.id}}">
                                        {{this.cat_name}}
                                    </a>

                                    <!-- Nút mở submenu subCategories -->
                                    {{#if this.subCategories.length}}
                                    <button class="btn dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                    {{/if}}

                                    <!-- Subcategories -->
                                    {{#if this.subCategories.length}}
                                    <ul class="dropdown-menu">
                                        {{#each this.subCategories}}
                                        <li>
                                            <a class="dropdown-item" href="/products?category={{this.id}}">
                                                {{this.cat_name}}
                                            </a>
                                        </li>
                                        {{/each}}
                                    </ul>
                                    {{/if}}
                                </li>
                                {{/each}}

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item" href="/products">
                                        <i class="bi bi-grid-3x3"></i> <strong>All Categories</strong>
                                    </a>
                                </li>
                            {{/if}}
                        </ul>
                    </li>

                </ul>
                
                <form method="GET" action="/products" class="d-flex me-3" role="search">
                    <div class="input-group">
                        <input class="form-control" type="search" name="search" placeholder="Search..." aria-label="Search">
                        <button class="btn btn-outline-light" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
                
                <ul class="navbar-nav">
                    {{#if user}}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> {{user.full_name}}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">

                                {{#if isAdmin}}
                                    <li><a class="dropdown-item" href="/admin/category">
                                        <i class="bi bi-speedometer2"></i> Admin Dashboard
                                    </a></li>                    
                                {{/if}}
                                    <li><a class="dropdown-item" href="/accounts/my_auctions">
                                            <i class="bi bi-bag"></i> My Auctions
                                        </a>
                                    </li>

                                    <li><a class="dropdown-item" href="/accounts/profile">
                                        <i class="bi bi-person"></i> Profile
                                    </a>
                                    </li>

                                    
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                    <form id="logoutForm" action="/accounts/signout" method="POST">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    {{else}}
                        <li class="nav-item">
                            <a class="nav-link" href="/accounts/signin">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary ms-2" href="/accounts/signup">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                        </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    {{#if messages}}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    {{#if messages.success}}
        Swal.fire({
        icon: 'success',
        title: 'Success',
        text: '{{messages.success}}',
        timer: 2500,
        showConfirmButton: false
        });
    {{/if}}

    {{#if messages.error}}
        Swal.fire({
        icon: 'error',
        title: 'Error',
        text: '{{messages.error}}'
        });
    {{/if}}

    {{#if messages.warning}}
        Swal.fire({
        icon: 'warning',
        title: 'Warning',
        text: '{{messages.warning}}'
        });
    {{/if}}

    {{#if messages.info}}
        Swal.fire({
        icon: 'info',
        title: 'Info',
        text: '{{messages.info}}'
        });
    {{/if}}
    </script>
    {{/if}}

    <!-- Main Content -->
    <main class="py-4">
        <div class="container">
            {{{body}}}
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer py-5 bg-dark text-light">
        <div class="container">
            <div class="row">
                <div class="col text-center mb-4">
                    <h5><i class="bi bi-hammer"></i> AuctionHub</h5>
                    <p class="text-light mb-2 ">PTUDW Final Project</p>
                    <p class="text-light mb-3">Team Members: Bao Gia, Khai Ly</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="https://www.facebook.com/gia.bao.612858" target="_blank" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="https://www.instagram.com/baogia_1509/" target="_blank" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-instagram"></i>
                        </a>
                    </div>
                </div>

            </div>

            <hr class="my-4 bg-light">

            <div class="row">
                <div class="col text-center text-muted">
                    <p class="mb-0">&copy; 2025 AuctionHub. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>


    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const submenus = document.querySelectorAll(".dropdown-submenu");

        submenus.forEach(menu => {
            menu.addEventListener("mouseenter", function () {
                const submenu = this.querySelector(".dropdown-menu");
                submenu.classList.add("show");
            });

            menu.addEventListener("mouseleave", function () {
                const submenu = this.querySelector(".dropdown-menu");
                submenu.classList.remove("show");
            });
        });
    });
    </script>

    {{{_sections.js}}}
</body>
</html>
