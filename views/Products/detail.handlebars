        </div>
    </div>

    <!-- Tabs -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white border-0">
                    <ul class="nav nav-tabs border-0" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active text-white-50"
                            data-bs-toggle="tab"
                            href="#description"
                            role="tab">
                                <i class="bi bi-file-text me-2"></i>Description
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white-50"
                            data-bs-toggle="tab"
                            href="#bidHistory"
                            role="tab">
                                <i class="bi bi-clock-history me-2"></i>Bid History
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50"
                            data-bs-toggle="tab"
                            href="#comments"
                            role="tab">
                                <i class="bi bi-chat-dots me-2"></i>Comments ({{product.total_comments}})
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="description">
                            {{#if product.description}}
                            <h5 class="mb-3 fw-bold">Product Description</h5>
                            <div>{{{product.description}}}</div>
                            {{else}}
                            <div class="empty-state">
                                <i class="bi bi-file-text d-block"></i>
                                <h5 class="text-muted">No Description</h5>
                            </div>
                            {{/if}}
                            {{#if product.isOwner}}
                            <button class="btn btn-outline-dark mt-3" data-bs-toggle="modal" data-bs-target="#editDescriptionModal">
                                <i class="bi bi-pencil me-2"></i>Edit
                            </button>
                            {{/if}}
                        </div>

                        <div class="tab-pane fade" id="bidHistory">
                            <h5 class="mb-3 fw-bold">Bid History</h5>
                            {{#if product.bidHistory}}
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Bidder</th>
                                        <th>Amount</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                        {{#if ./product.isOwner}}<th>Action</th>{{/if}}
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each product.bidHistory}}
                                    <tr>
                                        <td>
                                            {{#if ../product.isOwner}}
                                            <a href="/accounts/external_profile/{{this.id}}" class="text-decoration-none text-dark">
                                                <i class="bi bi-person-circle text-dark me-2"></i>{{this.bidder_name}}
                                            </a>
                                            {{else}}
                                                <i class="bi bi-person-circle text-dark me-2"></i>{{this.mask_name}}
                                            {{/if}}
                                        </td>
                                        <td class="fw-bold text-success">{{format_currency this.amount}}</td>
                                        <td><small class="text-muted">{{formatFullDate this.created_at}}</small></td>
                                        <td>
                                            {{#if this.is_rejected}}
                                                <span class="badge bg-danger text-white">Rejected</span>
                                            {{else}}
                                                <span class="badge bg-success text-white">Accepted</span>
                                            {{/if}}
                                        {{#if ../product.isOwner}}
                                        {{#if this.is_rejected }}
                                        <td>
                                            <span class="text-muted small">No actions available</span>
                                        </td>
                                        {{else}}
                                        <td>
                                            <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectBidModal"
                                                onclick="setBidToReject('{{this.bid_id}}', '{{this.bidder_name}}', '{{format_currency this.amount}}')">
                                                Reject
                                            </button>
                                        </td>
                                        {{/if}}
                                        {{/if}}
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                            {{else}}
                            <div class="empty-state">
                                <i class="bi bi-clock-history d-block"></i>
                                <h5 class="text-muted">No Bids Yet</h5>
                            </div>
                            {{/if}}
                        </div>

                        <div class="tab-pane fade" id="comments">
                            <h5 class="mb-4 fw-bold">Comments</h5>
                            {{#if user}}
                            <form method="post" action="/products/detail/{{product.auction_id}}/comments/create" class="mb-4">
                                <div class="card border-0 bg-light">
                                    <div class="card-body">
                                        <textarea class="form-control border-0 mb-3" name="content" rows="3" placeholder="Ask a question..." required></textarea>
                                        <button type="submit" class="btn btn-outline-dark">
                                            <i class="bi bi-send me-2"></i>Post
                                        </button>
                                    </div>
                                </div>
                            </form>
                            {{/if}}

                            {{#if product.comments}}
                            {{#each product.comments}}
                            <div class="comment-item border-bottom py-3">
                                <div class="d-flex">
                                    <a href="/accounts/external_profile/{{this.user_id}}" class="text-decoration-none text-dark">
                                    <div class="avatar rounded-circle d-flex align-items-center justify-content-center me-3"
                                        style="width: 40px; height: 40px;"
                                        data-name="{{this.user_name}}">
                                    </div>
                                    </a>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-semibold">{{this.user_name}}</h6>
                                        <small class="text-muted">{{this.time}}</small>
                                        <p class="mt-2 mb-2">{{this.content}}</p>
                                        {{#if ../user}}
                                        <button type="button" class="btn btn-sm btn-link p-0 text-dark text-decoration-none reply-btn">
                                            <i class="bi bi-reply me-1"></i>Reply
                                        </button>
                                        <form method="post" action="/products/detail/{{../product.auction_id}}/comments/create" class="reply-form d-none mt-3">
                                            <input type="hidden" name="parent_id" value="{{this.comment_id}}">
                                            <div class="card border-0 bg-light">
                                                <div class="card-body p-3">
                                                    <textarea class="form-control border-0 mb-2" name="content" rows="2" placeholder="Reply..." required></textarea>
                                                    <button class="btn btn-sm btn-dark"><i class="bi bi-send me-1"></i>Send</button>
                                                </div>
                                            </div>
                                        </form>
                                        {{/if}}
                                        {{#if this.reply}}
                                        {{#each this.reply}}
                                        <div class="reply-box rounded p-3 mt-3">
                                            <div class="d-flex">
                                                <i class="bi bi-reply-fill text-dark me-2"></i>
                                                <a href="/accounts/external_profile/{{this.user_id}}" class="text-decoration-none text-dark">
                                                <div class="avatar rounded-circle d-flex align-items-center justify-content-center me-3"
                                                    style="width: 40px; height: 40px;"
                                                    data-name="{{this.user_name}}">
                                                </div>
                                                </a>
                                                <div>
                                                    <strong class="small">{{this.user_name}}</strong>
                                                    <p class="mb-0 mt-1">{{this.content}}</p>
                                                    <small class="text-muted">{{this.time}}</small>
                                                </div>
                                            </div>
                                        </div>
                                        {{/each}}
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                            {{else}}
                            <div class="empty-state">
                                <i class="bi bi-chat-dots d-block"></i>
                                <h5 class="text-muted">No Comments</h5>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Related Products Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-grid me-2"></i>Related Products
                    </h5>
                </div>
                <div class="card-body p-4">
                    {{#if relatedProducts}}
                    <div class="row g-3">
                        {{#each relatedProducts}}
                        <div class="col-md-3 col-sm-6">
                                <div class="card border-0 h-100 shadow-sm hover-card">
                                    <div class="position-relative">
                                        <a href="/products/detail/{{this.auction_id}}" class="text-decoration-none">
                                            <img src="{{this.image_url}}" class="card-img-top" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
                                        </a>
                                        {{#if this.featured}}
                                        <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                                            <i class="bi bi-star-fill"></i> Featured
                                        </span>
                                        {{/if}}
                                        <span class="badge bg-dark position-absolute top-0 end-0 m-2">
                                            {{this.cat_name}}
                                        </span>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <a href="/products/detail/{{this.auction_id}}" class="text-decoration-none">
                                            <h6 class="card-title text-dark fw-bold mb-3" style="min-height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                {{this.name}}
                                            </h6>
                                        </a>

                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <small class="text-muted">
                                                    <i class="bi bi-cash-stack me-1"></i> Current Price
                                                </small>
                                                <span class="text-success fw-bold">{{format_currency this.currentPrice}}</span>
                                            </div>
                                        
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="bi bi-shop me-1"></i>Seller
                                                </small>
                                                <small class="text-danger fw-semibold">{{this.seller_name}}</small>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                {{#if this.top_bidder_name}}
                                                <small class="text-muted">
                                                    <i class="bi bi-trophy me-1"></i>Top Bidder
                                                </small>
                                                <small class="text-danger fw-semibold">{{this.top_bidder_name}}</small>
                                                {{else}}
                                                <small class="text-muted">
                                                    <i class="bi bi-trophy me-1"></i>Top Bidder
                                                </small>
                                                <small class="text-danger fw-semibold">No bids yet</small>
                                                {{/if}}
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="bi bi-clock me-1"></i>Time Remaining:
                                                </small>
                                                <small class="text-danger fw-semibold">{{this.time_remaining}}</small>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="bi bi-bar-chart me-1"></i>Total Bids:
                                                </small>
                                                <small class="text-danger fw-semibold">{{#if this.bid_count}} {{this.bid_count}} {{else}} 0 {{/if}}</small>
                                            </div>
                                        </div>

                                        <div class="mt-auto d-grid gap-2">
                                            <a href="/products/detail/{{this.auction_id}}" class="btn btn-outline-dark">
                                                <i class="bi bi-eye me-1"></i> View Details
                                            </a>

                                            {{#if ../user}}
                                            <form action="/products/add_to_watchlist/{{this.auction_id}}" method="POST">
                                                <button type="submit" class="btn btn-outline-danger w-100 btn-watchlist">
                                                    <i class="bi bi-heart me-1"></i> Add to Watchlist
                                                </button>
                                            </form>
                                            {{/if}}
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="text-center py-5">
                        <i class="bi bi-box fs-1 text-muted opacity-50 d-block mb-3"></i>
                        <p class="text-muted mb-0">No related products found</p>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="rejectBidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/products/detail/{{product.auction_id}}/bid/reject">
                <input type="hidden" name="bidId" id="modalBidId">
                <div class="modal-header">
                    <h5 class="modal-title">Reject Bid</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Reject bid from <strong id="modalBidderName"></strong> with amount <strong id="modalBidAmount"></strong> VNĐ?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editDescriptionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editDescriptionForm" action="/products/detail/{{product.auction_id}}/description/edit" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Description</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="quillEditor" style="height: 300px;"></div>
                    <input type="hidden" name="description" id="descriptionInput">
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>



<!-- Buy Now Modal -->
<div class="modal fade" id="buyNowModal" tabindex="-1" aria-labelledby="buyNowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <form action="/products/detail/{{product.auction_id}}/buy_now" method="POST">
                <!-- Header -->
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title" id="buyNowModalLabel">
                        <i class="bi bi-lightning-fill me-2"></i>Buy Now Confirmation
                    </h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 80px; height: 80px;">
                            <i class="bi bi-lightning-fill text-success" style="font-size: 2.5rem;"></i>
                        </div>
                        <h5 class="fw-bold mb-2">{{product.name}}</h5>
                    </div>

                    <div class="alert alert-light border mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Buy Now Price:</span>
                            <span class="text-success fw-bold fs-4">
                                {{format_currency product.buy_now_price}} VNĐ
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-warning border-warning d-flex align-items-start">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2 mt-1"></i>
                        <div>
                            <strong>Important:</strong>
                            <p class="mb-0 small">
                                By clicking "Confirm Purchase", you agree to buy this item immediately at the Buy Now price.
                                This action cannot be undone and the auction will end.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-lightning-fill me-2"></i>Confirm Purchase
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>



<!-- Confirm Bid Modal -->
<div class="modal fade" id="confirmBidModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">

      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title">
          <i class="bi bi-hammer me-2"></i>Confirm Your Bid
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4">
        <div class="text-center mb-3">
          <p class="text-muted mb-1">You are about to place a bid of</p>
          <h3 class="fw-bold text-success" id="confirmBidAmount">0 VNĐ</h3>
        </div>

        <div class="alert alert-warning small">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          Your bid is binding. If you win, you are obligated to complete the purchase.
        </div>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-dark" id="confirmBidBtn">
          <i class="bi bi-check-circle me-2"></i>Confirm Bid
        </button>
      </div>

    </div>
  </div>
</div>
