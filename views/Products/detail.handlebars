    });

    document.getElementById('editDescriptionForm').addEventListener('submit', function(e) {
        const description = quill.root.innerHTML;
        document.getElementById('descriptionInput').value = description;
    });
</script>


<script>
    function stringToColor(str) {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
            hash = str.charCodeAt(i) + ((hash << 5) - hash);
        }

        const hue = Math.abs(hash) % 360;
        return `hsl(${hue}, 65%, 50%)`;
    }

    function getInitial(name) {
        return name?.trim()?.charAt(0)?.toUpperCase() || '?';
    }

    const fullName = "{{product.seller_name}}";
    const avatar = document.getElementById('avatar');

    avatar.textContent = getInitial(fullName);
    avatar.style.backgroundColor = stringToColor(fullName);

    const topBidderName = "{{#if topBidderInfo}}{{topBidderInfo.full_name}}{{/if}}";
    const avatarTopBidder = document.getElementById('avatarTopBidder');
    if (avatarTopBidder && topBidderName) {
        avatarTopBidder.textContent = getInitial(topBidderName);
        avatarTopBidder.style.backgroundColor = stringToColor(topBidderName);
    }

    document.querySelectorAll('.avatar').forEach(avatar => {
        const name = avatar.dataset.name;
        avatar.textContent = getInitial(name);
        avatar.style.backgroundColor = stringToColor(name);
    });
</script>



<script>
document.addEventListener('DOMContentLoaded', function () {
    const thumbs = document.querySelectorAll('#carousel-thumbs .thumb-img');
    const carouselEl = document.getElementById('auctionCarousel');

    function clearThumbActive() {
        thumbs.forEach(t => t.classList.remove('active', 'border-dark', 'border-3'));
    }

    // Click on thumbnail: visually mark active (Bootstrap will change slide via data attributes)
    thumbs.forEach(thumb => {
        thumb.addEventListener('click', function () {
            clearThumbActive();
            this.classList.add('active', 'border-dark', 'border-3');
        });
    });

    // Sync thumbnail active state when carousel slide changes
    if (carouselEl && typeof bootstrap !== 'undefined') {
        carouselEl.addEventListener('slid.bs.carousel', function (evt) {
            const activeIndex = evt.to;
            clearThumbActive();
            const newActive = document.querySelector(`#carousel-thumbs [data-bs-slide-to='${activeIndex}']`);
            if (newActive) newActive.classList.add('active', 'border-dark', 'border-3');
        });
    }
});
</script>
