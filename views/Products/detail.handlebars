                        {{#each product.images}}
                        <div class="carousel-item {{#if this.is_thumbnail}}active{{/if}}">
                            <img src="{{this.image_url}}" class="d-block w-100" alt="{{../product.name}}" style="height: 500px; object-fit: contain; padding: 20px;">
                        </div>
                        {{/each}}
                    {{else}}
                        <div class="carousel-item active">
                            <img src="https://picsum.photos/600/400?random=1" class="d-block w-100" alt="Product" style="max-height: 500px; object-fit: contain; padding: 20px;">
                        </div>
                    {{/if}}
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#auctionCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#auctionCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>

            <div class="d-flex gap-2 overflow-auto pb-2" id="carousel-thumbs">
                {{#if product.images}}
                    {{#each product.images}}
                    <img src="{{this.image_url}}" 
                         class="img-thumbnail thumb-img {{#if this.is_thumbnail}}active border-dark border-3{{/if}}" 
