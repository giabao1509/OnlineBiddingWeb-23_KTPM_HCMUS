                                <i class="bi bi-shop me-2"></i>Seller Information
                            </h5>
                        </div>
                        
                        <div class="d-flex align-items-center">
                            <a href="/accounts/external_profile/{{sellerInfo.id}}" class="text-decoration-none text-dark">
                            <div id="avatar"
                                class="rounded-circle text-white d-flex align-items-center justify-content-center me-3 flex-shrink-0 fw-bold"
                                style="width: 80px; height: 80px; font-size: 2rem;">
                            </div>
                            </a>
