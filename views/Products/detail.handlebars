<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a href="/products" class="text-decoration-none">Auctions</a></li>
                    <li class="breadcrumb-item"><a href="/products?category={{product.category_id}}" class="text-decoration-none">{{product.cat_name}}</a></li>
                    <li class="breadcrumb-item active">{{product.name}}</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row g-4">
