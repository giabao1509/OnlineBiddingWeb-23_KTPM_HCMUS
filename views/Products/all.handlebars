{{#section 'css'}}
<style>
/* Related Products Hover Effect */
.hover-card {
    transition: all 0.3s ease;
}

.hover-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15) !important;
}

.hover-card .card-img-top {
    transition: all 0.3s ease;
}

.hover-card:hover .card-img-top {
    transform: scale(1.05);
}

.hover-card .position-relative {
    overflow: hidden;
    border-radius: 8px 8px 0 0;
}

/* Pagination */
.pagination {
    --bs-pagination-padding-x: 0.75rem;
    --bs-pagination-padding-y: 0.5rem;
    --bs-pagination-font-size: 0.875rem;
    --bs-pagination-color: #212529;
    --bs-pagination-bg: #fff;
    --bs-pagination-border-color: #dee2e6;
    --bs-pagination-hover-color: #000;
    --bs-pagination-hover-bg: #f8f9fa;
    --bs-pagination-active-color: #fff;
    --bs-pagination-active-bg: #212529;
    --bs-pagination-active-border-color: #212529;
}

.pagination .page-link {
    transition: all 0.2s ease;
}

.pagination .page-item.active .page-link {
    font-weight: 600;
}

/* Search Card */
.search-card {
    background: #fff;
    border-radius: 12px;
}

/* Filter Badges */
.filter-badge {
    transition: all 0.2s ease;
}

.filter-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

/* Action Buttons */
.btn-watchlist {
    transition: all 0.3s ease;
}

.btn-watchlist:hover {
    transform: scale(1.05);
}
</style>
{{/section}}

<div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-3">
                <i class="bi bi-hammer"></i> Auction Sessions
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active">Auctions</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Filters & Search -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm search-card">
                <div class="card-body p-4">
                    <form method="GET" action="/products">
                        <div class="row g-3">
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label fw-semibold">Search</label>
                                <input type="text" class="form-control" name="search" placeholder="Enter keywords..." value="{{query.search}}">
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <label class="form-label fw-semibold">Category</label>
                                <select class="form-select" name="category">
                                    <option value="" {{#unless selectedCategory}}selected{{/unless}}>All Categories</option>
                                    {{#each categories}}
                                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.cat_name}}</option>
                                        {{#each this.subCategories}}
                                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>&nbsp;&nbsp;{{this.cat_name}}</option>
                                        {{/each}}
                                    {{/each}}
                                </select>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <label class="form-label fw-semibold">Sort By</label>
                                <select name="sort" class="form-select">
                                    {{#each sortOptions}}
                                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                                    {{/each}}
                                </select>
                            </div>

                            <div class="col-lg-2 col-md-6">
                                <label class="form-label d-none d-md-block">&nbsp;</label>
                                <button type="submit" class="btn btn-dark w-100">
                                    <i class="bi bi-search"></i> Search
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Count -->
    <div class="row mb-3">
        <div class="col-12">
            <p class="text-muted mb-0">
                Found <strong>{{totalResults}}</strong> auction{{#if (gt totalResults 1)}}s{{/if}}
            </p>
        </div>
    </div>

    <!-- Auction Items Grid -->
    <div class="row">
        <div class="col-12">
            {{#if products}}
            <div class="row g-3">
                {{#each products}}
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card border-0 h-100 shadow-sm hover-card">
                        <div class="position-relative">
                            <a href="/products/detail/{{this.auction_id}}" class="text-decoration-none">
                                <img src="{{this.image_url}}" class="card-img-top" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
                            </a>
                            {{#if this.featured}}
                            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                                <i class="bi bi-star-fill"></i> Featured
                            </span>
                            {{/if}}
                            <span class="badge bg-dark position-absolute top-0 end-0 m-2">
                                {{this.category_name}}
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <a href="/products/detail/{{this.auction_id}}" class="text-decoration-none">
                                <h6 class="card-title text-dark fw-bold mb-3" style="min-height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    {{this.name}}
                                </h6>
                            </a>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-cash-stack me-1"></i> Current Price
                                    </small>
                                    <span class="text-success fw-bold">{{format_currency this.currentPrice}}</span>
                                </div>
                            
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="bi bi-shop me-1"></i>Seller
                                    </small>
                                    <small class="text-danger fw-semibold">{{this.seller_name}}</small>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    {{#if this.top_bidder_name}}
                                    <small class="text-muted">
                                        <i class="bi bi-trophy me-1"></i>Top Bidder
                                    </small>
                                    <small class="text-danger fw-semibold">{{this.top_bidder_name}}</small>
                                    {{else}}
                                    <small class="text-muted">
                                        <i class="bi bi-trophy me-1"></i>Top Bidder
                                    </small>
                                    <small class="text-danger fw-semibold">No bids yet</small>
                                    {{/if}}
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>Time Remaining:
                                    </small>
                                    <small class="text-danger fw-semibold">{{this.time_remaining}}</small>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="bi bi-bar-chart me-1"></i>Total Bids:
                                    </small>
                                    <small class="text-danger fw-semibold">{{#if this.bid_count}} {{this.bid_count}} {{else}} 0 {{/if}}</small>
                                </div>
                            </div>

                            <div class="mt-auto d-grid gap-2">
                                <a href="/products/detail/{{this.auction_id}}" class="btn btn-outline-dark">
                                    <i class="bi bi-eye me-1"></i> View Details
                                </a>
                                {{#if ../user}}
                                <form action="/products/add_to_watchlist/{{this.auction_id}}" method="POST">
                                    <button type="submit" class="btn btn-outline-danger w-100 btn-watchlist">
                                        <i class="bi bi-heart me-1"></i> Add to Watchlist
                                    </button>
                                </form>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="text-center py-5">
                <i class="bi bi-search fs-1 text-muted opacity-50 d-block mb-3"></i>
                <h5 class="text-muted">No auctions found</h5>
                <p class="text-muted">Try adjusting your filters or search terms</p>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- Pagination -->

    {{#if (gt totalPages 1)}}
    <div class="row mt-5">
        <div class="col-12">
            <nav aria-label="Page navigation">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Showing page {{currentPage}} of {{totalPages}}</small>
                    <ul class="pagination justify-content-center">
                        {{#if query}}
                            <!-- Prev -->
                            <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                                <a class="page-link" href="/products?page={{prevPage}}&search={{query.search}}&category={{query.category}}&sort={{query.sort}}">
                                    <i class="bi bi-chevron-left"></i> Prev
                                </a>
                            </li>

                            <!-- Pages -->
                            {{#each pages}}
                            <li class="page-item {{#if this.active}}active{{/if}}">
                                <a class="page-link" href="/products?page={{this.number}}&search={{../query.search}}&category={{../query.category}}&sort={{../query.sort}}">
                                    {{this.number}}
                                </a>
                            </li>
                            {{/each}}

                            <!-- Next -->
                            <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                                <a class="page-link" href="/products?page={{nextPage}}&search={{query.search}}&category={{query.category}}&sort={{query.sort}}">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                            {{else}}
                            <!-- Prev -->
                            <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                                <a class="page-link" href="/products?page={{prevPage}}">
                                    <i class="bi bi-chevron-left"></i> Prev
                                </a>
                            </li>

                            <!-- Pages -->
                            {{#each pages}}
                            <li class="page-item {{#if this.active}}active{{/if}}">
                                <a class="page-link" href="/products?page={{this.number}}">
                                    {{this.number}}
                                </a>
                            </li>
                            {{/each}}

                            <!-- Next -->
                            <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                                <a class="page-link" href="/products?page={{nextPage}}">
                                    Next <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        {{/if}}
                    </ul>

                </div>
                
            </nav>
        </div>
    </div>
    {{/if}}
</div>