                            <!-- Chứng từ thanh toán -->
                            <div class="mb-3">
                            <label class="form-label">Chứng từ thanh toán *</label>
                            <input type="file"
                                class="form-control"
                                id="paymentProof"
                                name="paymentProof"
                                accept="image/*"
                                required>

                            <small class="text-muted">
                                Upload ảnh chuyển khoản hoặc biên lai thanh toán
                            </small>


                            <!-- preview ảnh mới -->
                            <div id="paymentPreview" class="mt-2 d-none">
                                <img id="paymentPreviewImg"
                                    class="img-thumbnail"
                                    style="max-width:200px">

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger mt-2"
                                        id="removePaymentImage">
                                    Xoá ảnh
                                </button>
                            </div>
                            </div>

                            <!-- Địa chỉ -->
                            <div class="mb-3">
                            <label class="form-label">Địa chỉ nhận hàng *</label>
                            <textarea class="form-control"
                                        name="address"
                                        rows="2"
                                        required></textarea>
                            </div>

                            <!-- SĐT -->
                            <div class="mb-3">
                            <label class="form-label">Số điện thoại *</label>
                            <input type="tel"
                                    class="form-control"
                                    name="phone"
                                    value=""
                                    required>
                            </div>

                            <!-- Ghi chú -->
                            <div class="mb-3">
                            <label class="form-label">Ghi chú (không bắt buộc)</label>
                            <textarea class="form-control"
                                        name="notes"
                                        rows="2"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i>
                            Gửi thông tin thanh toán
                            </button>
                        </form>
                    </div>

                        
                    {{else}}
                        <h5 class="mb-4"><i class="bi bi-1-circle-fill text-primary"></i> Bước 1: Đang chờ người mua thanh toán</h5>
