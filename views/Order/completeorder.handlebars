                                    <input type="radio" class="btn-check" name="rating" id="negative" value="-1" required>
                                    <label class="btn btn-outline-danger" for="negative">
                                        <i class="bi bi-hand-thumbs-down"></i> Tiêu cực (-1)
                                    </label>
                                    </div>
                                </div>

                                
                                <div class="mb-3">
                                    <label class="form-label">Nhận xét *</label>
                                    <textarea class="form-control" name="comment" id="comment" rows="3" placeholder="Chia sẻ trải nghiệm của bạn..." required></textarea>
                                    <small class="text-muted">Tối thiểu 10 ký tự</small>
                                </div>

                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send"></i> Gửi đánh giá
                                </button>
                                </form>
                            {{/if }}
                        {{/if}}
                    {{/if}}
            </div>

        </div>
    </div>

    {{#if isOrderSeller}}
        <div class="card border-danger">
            <div class="card-body">
                <h6 class="card-title text-danger">Huỷ giao dịch</h6>
                <p class="small text-muted">
                Bạn có thể huỷ giao dịch nếu người mua không đáp ứng yêu cầu
                </p>

                <button
                type="button"
                class="btn btn-danger btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#cancelOrderModal">
                <i class="bi bi-x-circle"></i> Huỷ giao dịch
                </button>
            </div>
        </div>
    {{/if}}
</div>

    


  <!-- Chat box -->
  <div class="col-md-4">
    <div class="card">
      <div class="card-header bg-primary text-white">
        <i class="bi bi-chat-dots"></i> Trò chuyện với {{#if isOrderBuyer}}người bán{{else}}người mua{{/if}}
      </div>
      <div class="card-body p-0">
        <div class="chat-box" id="chatBox">
          {{#each formattedMessages}}
          <div class="message {{sender}}">
            <div class="message-bubble">
              <div>{{content}}</div>
              <small class="text-muted" style="font-size: 0.75rem;">{{formatFullDate created_at}}</small>
            </div>
          </div>
          {{/each}}
        </div>
        <div class="p-3 border-top">
          <form id="chatForm" method="post" action="/orders/{{order.id}}/send_message">
            <div class="input-group">
              <input type="text" class="form-control" name="content" id="content" placeholder="Nhập tin nhắn..." required>
              <button class="btn btn-primary" type="submit">
                <i class="bi bi-send"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Thông tin bên kia -->
    <div class="card mt-3">
      <div class="card-body">
        <h6 class="card-title">{{#if isOrderSeller}}Người mua{{else}}Người bán{{/if}}</h6>
        <p class="mb-1"><strong>{{#if isOrderSeller}} {{bidderInfo.bidder_name}} {{else}} {{sellerInfo.seller_name}} {{/if}}</strong></p>
        <div class="rating-stars mb-1">
          {{#if isOrderSeller}}
            ★ {{bidderInfo.rating_score}}
          {{else}}
            ★ {{sellerInfo.rating_score}}
          {{/if}}
        </div>
        <small class="text-muted">
          {{#if isOrderSeller}}
            {{bidderInfo.bidder_reviews}} lượt đánh giá
          {{else}}
            {{sellerInfo.seller_reviews}} lượt đánh giá
          {{/if}}
        </small>
      </div>
    </div>
  </div>
</div>
{{/if}}


<div class="modal fade" id="editRatingModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form method="post" action="/orders/{{order.id}}/update_rate">
        <div class="modal-header">
          <h5 class="modal-title">Chỉnh sửa đánh giá</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <!-- hidden -->
          <input type="hidden" name="reviewer" value="{{order.orderRating.reviewer_id}}">
          <input type="hidden" name="reviewee" value="{{order.orderRating.reviewee_id}}">

          <!-- rating -->
          <div class="mb-3">
            <label class="form-label">Đánh giá người mua</label>
            <div class="btn-group w-100">
              <input type="radio" class="btn-check" name="rating" id="edit_positive" value="1">
              <label class="btn btn-outline-success" for="edit_positive">
                👍 Tích cực (+1)
              </label>

              <input type="radio" class="btn-check" name="rating" id="edit_negative" value="-1">
              <label class="btn btn-outline-danger" for="edit_negative">
                👎 Tiêu cực (-1)
              </label>
            </div>
          </div>

          <!-- comment -->
          <div class="mb-3">
            <label class="form-label">Nhận xét</label>
            <textarea class="form-control"
                      name="comment"
                      id="editComment"
                      rows="3"
                      required></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">
            Huỷ
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Cập nhật
          </button>
        </div>
      </form>
    </div>
  </div>
</div>



<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <form
        method="POST"
        action="/orders/{{order.id}}/cancel">
        <input type="hidden" name="reviewee" value="{{order.winner_bidder_id}}">
        <input type="hidden" name="reviewer" value="{{order.seller_id}}">
        <!-- Header -->
        <div class="modal-header border-0">
          <h5 class="modal-title text-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Xác nhận huỷ giao dịch
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <!-- Body -->
        <div class="modal-body">
          <p>
            Bạn có chắc chắn muốn <strong class="text-danger">huỷ giao dịch</strong> này không?
          </p>

          <div class="alert alert-warning small">
            <ul class="mb-0">
              <li>Giao dịch sẽ bị đóng vĩnh viễn</li>
              <li>Người mua sẽ bị đánh giá <strong>-1 điểm</strong></li>
              <li>Hành động này <strong>không thể hoàn tác</strong></li>
            </ul>
          </div>

          <!-- Lý do huỷ (khuyên dùng) -->
          <div class="mb-2">
            <label class="form-label small">
              Lý do huỷ (không bắt buộc)
            </label>
            <textarea
              name="cancel_reason"
              class="form-control"
              rows="2"
              placeholder="Người thắng không thanh toán"></textarea>
          </div>

        <!-- Footer -->
        <div class="modal-footer border-0">
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm"
            data-bs-dismiss="modal">
            Quay lại
          </button>

          <button
            type="submit"
            class="btn btn-danger btn-sm">
            <i class="bi bi-x-circle"></i> Xác nhận huỷ
          </button>
        </div>

      </form>

    </div>
  </div>
</div>



