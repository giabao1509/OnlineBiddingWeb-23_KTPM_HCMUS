{{#section 'css'}}

<style>
    body { background-color: #f5f5f5; }
    .main-container { max-width: 1200px; margin: 2rem auto; }
    .card { box-shadow: 0 2px 8px rgba(0,0,0,0.1); border: none; }
    .step-indicator { display: flex; justify-content: space-between; margin-bottom: 2rem; }
    .step { flex: 1; text-align: center; position: relative; }
    .step::before { content: ''; position: absolute; top: 20px; left: 0; right: 0; height: 2px; background: #dee2e6; z-index: -1; }
    .step:first-child::before { left: 50%; }
    .step:last-child::before { right: 50%; }
    .step-circle { width: 40px; height: 40px; border-radius: 50%; background: #dee2e6; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 0.5rem; font-weight: bold; }
    .step.active .step-circle { background: #0d6efd; color: white; }
    .step.completed .step-circle { background: #198754; color: white; }
    .chat-box { height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px; padding: 1rem; background: white; }
    .message { margin-bottom: 1rem; }
    .message.receiver { text-align: left; }
    .message.sender { text-align: right; }
    .message-bubble { display: inline-block; padding: 0.5rem 1rem; border-radius: 18px; max-width: 70%; }
    .message.receiver .message-bubble { background: #e9ecef; }
    .message.sender .message-bubble { background: #0d6efd; color: white; }
    .rating-stars { font-size: 1.5rem; color: #ffc107; }
  </style>
{{/section}}

{{#section 'js'}}
<script>
function openEditRatingModal(rating, comment) {
    // set radio
    document.getElementById('edit_positive').checked = rating === 1;
    document.getElementById('edit_negative').checked = rating === -1;

    // set comment
    document.getElementById('editComment').value = comment || '';

    // show modal
    const modal = new bootstrap.Modal(
        document.getElementById('editRatingModal')
    );
    modal.show();
}
</script>


<script>
const input = document.getElementById('paymentProof');
const previewBox = document.getElementById('paymentPreview');
const previewImg = document.getElementById('paymentPreviewImg');
const removeBtn = document.getElementById('removePaymentImage');

input.addEventListener('change', () => {
    const file = input.files[0];
    if (!file) return;

    previewImg.src = URL.createObjectURL(file);
    previewBox.classList.remove('d-none');
});

removeBtn.addEventListener('click', () => {
    input.value = '';                 // clear file
    previewImg.src = '';
    previewBox.classList.add('d-none');
});
</script>


<script>
const shippingInput = document.getElementById('shippingProof');
const shippingPreviewBox = document.getElementById('shippingPreview');
const shippingPreviewImg = document.getElementById('shippingPreviewImg');
const shippingremoveBtn = document.getElementById('removeShippingImage');

shippingInput.addEventListener('change', () => {
    const file = shippingInput.files[0];
    if (!file) return;

    shippingPreviewImg.src = URL.createObjectURL(file);
    shippingPreviewBox.classList.remove('d-none');
});

shippingremoveBtn.addEventListener('click', () => {
    shippingInput.value = '';                 // clear file
    shippingPreviewImg.src = '';
    shippingPreviewBox.classList.add('d-none');
});
</script>


{{/section}}
<!-- ========================== -->
<!-- views/order-completion.hbs -->
<!-- ========================== -->
{{#if (eq order.status 'Cancelled')}}
    <div class="alert alert-danger d-flex align-items-start gap-2">
        <i class="bi bi-x-octagon-fill fs-4"></i>
        <div>
            <strong>Giao dịch đã bị huỷ</strong>
            <div class="small mt-1">
            Huỷ bởi: Người bán<br>
            Lý do: {{order.orderRating.comment}}
            </div>
        </div>
    </div>
{{else}}
<div class="row">
  <!-- Thông tin sản phẩm -->
  <div class="col-12 mb-4">
    <div class="card">
      <div class="card-body">
        <div class="row align-items-center">
          <div class="col-md-2">
            <img src="{{order.image_url}}" alt="{{order.name}}" class="img-fluid rounded">
          </div>
          <div class="col-md-6">
            <h5 class="mb-1">{{order.name}}</h5>
            <p class="text-muted mb-0">Mã đơn: {{order.id}}</p>
          </div>
          <div class="col-md-4 text-end">
            <h4 class="text-primary mb-0">{{format_currency order.final_price}}</h4>
            <small class="text-muted">Kết thúc: {{formatFullDate order.end_time}}</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Thanh tiến trình -->
  <div class="col-12 mb-4">
    <div class="card">
      <div class="card-body">
        <h6 class="card-title mb-4">Tiến trình hoàn tất đơn hàng</h6>
        <div class="step-indicator">
          <div class="step {{#if (eq order.step 1)}}active{{/if}} {{#if (gte order.step 2)}}completed{{/if}}">
            <div class="step-circle">1</div>
            <div>Thanh toán</div>
          </div>
          <div class="step {{#if (eq order.step 2)}}active{{/if}} {{#if (gte order.step 3)}}completed{{/if}}">
            <div class="step-circle">2</div>
            <div>Vận chuyển</div>
          </div>
          <div class="step {{#if (eq order.step 3)}}active{{/if}} {{#if (eq order.step 4)}}completed{{/if}}">
            <div class="step-circle">3</div>
            <div>Nhận hàng</div>
          </div>
          <div class="step {{#if (gte order.step 4)}}active{{/if}} {{#if order.orderRating}}completed{{/if}}">
            <div class="step-circle">4</div>
            <div>Đánh giá</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Nội dung chính -->
    <div class="col-md-8">
    <div class="card mb-4">
        <div class="card-body">
            <div>   
                 {{#if (eq order.step 1)}}
                    {{#if isOrderBuyer}}
