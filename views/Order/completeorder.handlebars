                        <i class="bi bi-clock-history"></i> Đang chờ người mua gửi thông tin thanh toán và địa chỉ nhận hàng.
                        </div>

                        <div class="card bg-light">
                        <div class="card-body">
                            <h6>Thông tin người mua:</h6>
                            <p class="mb-1"><strong>{{bidderInfo.bidder_name}}</strong></p>
                            <p class="mb-1">Đánh giá: ★ {{bidderInfo.rating_score}}</p>
                            <p class="mb-0 text-muted small">{{bidderInfo.bidder_reviews}} lượt đánh giá</p>
                        </div>
                        </div>

                    {{/if}}
                {{/if}}
            </div>
       
            <div> 
                {{#if (eq order.step 2)}}
