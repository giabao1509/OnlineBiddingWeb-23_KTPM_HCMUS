                                <img id="shippingPreviewImg"
                                    class="img-thumbnail"
                                    style="max-width:200px">

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger mt-2"
                                        id="removeShippingImage">
                                    Xoá ảnh
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-truck"></i> Xác nhận đã gửi hàng
                        </button>
                        </form>
                    {{else}}
                    <h5 class="mb-4"><i class="bi bi-2-circle-fill text-primary"></i> Bước 2: Đang chờ người bán gửi hàng</h5>
