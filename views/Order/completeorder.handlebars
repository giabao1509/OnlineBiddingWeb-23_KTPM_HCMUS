                        <div class="card-body">
                            <h6>Địa chỉ giao hàng:</h6>
                            <p class="mb-1">{{order.payment_address}}</p>
                            <p class="mb-1">SĐT: {{order.payment_phone}}</p>
                            {{#if order.payment_notes}}
                            <p class="mb-0 text-muted small">Ghi chú: {{order.payment_notes}}</p>
                            {{/if}}
                        </div>
                        </div>
                        {{/if}}

                        <hr>
                        <form id="shippingForm" method="post" action="/orders/{{order.id}}/confirm_delivery" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Hóa đơn vận chuyển</label>
                            <input type="file"
                                class="form-control"
                                id="shippingProof"
                                name="shippingProof"
                                accept="image/*"
                                required>

