<!-- Page Header -->
<div class="container py-4">
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="fw-bold mb-2">
        <i class="bi bi-plus-circle me-2 text-primary"></i>Create Auction Product
      </h2>
      <p class="text-secondary">Fill in all required information to list your product</p>
    </div>
  </div>

  <form action="/seller/create_product" method="POST" enctype="multipart/form-data" id="productForm">
    <div class="row g-4">
      <!-- Left Column -->
      <div class="col-lg-8">
        <!-- Basic Information -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-dark text-white border-0 py-3">
            <h5 class="mb-0">
              <i class="bi bi-info-circle me-2"></i>Basic Information
            </h5>
          </div>
          <div class="card-body p-4">
            <!-- Product Name -->
            <div class="mb-4">
              <label class="form-label fw-semibold">
                Product Name <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control form-control-lg" name="title" required 
                     placeholder="e.g. iPhone 15 Pro Max 256GB - Official VN/A">
              <small class="text-muted mt-1 d-block">
                <i class="bi bi-lightbulb text-warning"></i>
                A clear and detailed title helps attract more buyers
              </small>
            </div>

            <!-- Category -->
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">
                  Parent Category <span class="text-danger">*</span>
                </label>
                <select class="form-select form-select-lg" name="parentCategory" id="parentCategory" required>
                  <option value="">-- Select Parent Category --</option>
                  {{#each categories}}
                    <option value="{{id}}">{{cat_name}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">
                  Subcategory <span class="text-danger">*</span>
                </label>
                <select class="form-select form-select-lg" name="subCategory" id="subCategory" required>
                  <option value="">-- Select Subcategory --</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Images Upload -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-dark text-white border-0 py-3">
            <h5 class="mb-0">
              <i class="bi bi-images me-2"></i>Product Images
            </h5>
          </div>
          <div class="card-body p-4">
            <div class="alert alert-light border d-flex align-items-start mb-3">
              <i class="bi bi-info-circle text-primary me-2 mt-1"></i>
              <div>
                <small><strong>Minimum 3 images required.</strong> The first image will be used as the main thumbnail.</small>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Upload Images</label>
              <input type="file" class="form-control form-control-lg" name="images" id="imageInput" 
                     accept="image/*" multiple required>
            </div>
            
            <!-- Image Preview -->
            <div id="imagePreview" class="row g-3 mb-3"></div>
            
            <div class="d-flex align-items-center justify-content-between">
              <small class="text-muted">
                <i class="bi bi-check-circle text-success me-1"></i>
                Uploaded: <span id="imageCount" class="fw-bold">0</span>/10 images
              </small>
              <small class="text-muted">
                Maximum file size: 5MB per image
              </small>
            </div>
          </div>
        </div>

        <!-- Product Description -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-dark text-white border-0 py-3">
            <h5 class="mb-0">
              <i class="bi bi-file-text me-2"></i>Product Description
            </h5>
          </div>
          <div class="card-body p-4">
            <div id="editor" style="min-height: 300px;"></div>
            <input type="hidden" name="description" id="descriptionInput">
            <small class="text-muted d-block mt-3">
              <i class="bi bi-lightbulb text-warning"></i>
              Include product details, condition, specifications, and any important information
            </small>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="col-lg-4">
        <!-- Pricing -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-dark text-white border-0 py-3">
            <h5 class="mb-0">
              <i class="bi bi-currency-dollar me-2"></i>Pricing & Duration
            </h5>
          </div>
          <div class="card-body p-4">
            <!-- Start Price -->
            <div class="mb-4">
              <label class="form-label fw-semibold">
                Starting Price <span class="text-danger">*</span>
              </label>
              <div class="input-group input-group-lg">
                <input type="text" class="form-control" id="startPrice_display" 
                       placeholder="0" required>
              </div>
              <input type="hidden" name="startPrice" id="startPrice_hidden" required>
              <small class="text-muted mt-1 d-block">Minimum starting bid</small>
            </div>

            <!-- Bid Step -->
            <div class="mb-4">
              <label class="form-label fw-semibold">
                Bid Increment <span class="text-danger">*</span>
              </label>
              <div class="input-group input-group-lg">
                <input type="text" class="form-control" id="bidStep_display" 
                       placeholder="100,000" required>
              </div>
              <input type="hidden" name="bidStep" id="bidStep_hidden" value="100000" required>
              <small class="text-muted mt-1 d-block">
                Each bid must increase by at least this amount
              </small>
            </div>

            <!-- Buy Now Price -->
            <div class="mb-4">
              <label class="form-label fw-semibold">
                Buy Now Price <span class="badge bg-secondary ms-1">Optional</span>
              </label>
              <div class="input-group input-group-lg">
                <input type="text" class="form-control" id="buyNowPrice_display" 
                       placeholder="0">
              </div>
              <input type="hidden" name="buyNowPrice" id="buyNowPrice_hidden">
              <small class="text-muted mt-1 d-block">
                Buyers can instantly purchase at this price
              </small>
            </div>

            <hr class="my-4">

            <!-- Auction Duration -->
            <div class="mb-4">
              <label class="form-label fw-semibold">
                Auction Duration <span class="text-danger">*</span>
              </label>
              <select class="form-select form-select-lg" name="duration" required>
                <option value="">-- Select Duration --</option>
                <option value="3">3 days</option>
                <option value="5">5 days</option>
                <option value="7" selected>7 days (Recommended)</option>
                <option value="10">10 days</option>
                <option value="14">14 days</option>
              </select>
            </div>

            <!-- Allow New User -->
            <div class="card bg-light border-0">
              <div class="card-body py-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" name="allowNew" id="allowNew" checked>
                  <label class="form-check-label fw-semibold" for="allowNew">
                    Allow New User To Bid
                  </label>
                </div>
                <small class="text-muted d-block mt-2">
                    User do not have any rating can bid this auction
                </small>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Buttons -->
        <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
          <div class="card-body p-3">
            <button type="submit" class="btn btn-dark btn-lg w-100 mb-2">
              <i class="bi bi-upload me-2"></i>Publish Auction
            </button>
            <button type="button" class="btn btn-outline-secondary btn-lg w-100" onclick="history.back()">
              <i class="bi bi-x-circle me-2"></i>Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

{{#section 'css'}}
<!-- Include Quill CSS -->
