{{#section 'css'}}

<style>
    body { background-color: #f5f5f5; }
    .main-container { max-width: 1200px; margin: 2rem auto; }
    .card { box-shadow: 0 2px 8px rgba(0,0,0,0.1); border: none; }
    .step-indicator { display: flex; justify-content: space-between; margin-bottom: 2rem; }
    .step { flex: 1; text-align: center; position: relative; }
    .step::before { content: ''; position: absolute; top: 20px; left: 0; right: 0; height: 2px; background: #dee2e6; z-index: -1; }
    .step:first-child::before { left: 50%; }
    .step:last-child::before { right: 50%; }
    .step-circle { width: 40px; height: 40px; border-radius: 50%; background: #dee2e6; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 0.5rem; font-weight: bold; }
    .step.active .step-circle { background: #0d6efd; color: white; }
    .step.completed .step-circle { background: #198754; color: white; }
    .chat-box { height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px; padding: 1rem; background: white; }
    .message { margin-bottom: 1rem; }
    .message.buyer { text-align: left; }
    .message.seller { text-align: right; }
    .message-bubble { display: inline-block; padding: 0.5rem 1rem; border-radius: 18px; max-width: 70%; }
    .message.buyer .message-bubble { background: #e9ecef; }
    .message.seller .message-bubble { background: #0d6efd; color: white; }
    .rating-stars { font-size: 1.5rem; color: #ffc107; }
  </style>
{{/section}}

{{#section 'js'}}
<script>
const input = document.getElementById('paymentProof');
const previewBox = document.getElementById('paymentPreview');
const previewImg = document.getElementById('paymentPreviewImg');
const removeBtn = document.getElementById('removePaymentImage');

input.addEventListener('change', () => {
    const file = input.files[0];
    if (!file) return;

    previewImg.src = URL.createObjectURL(file);
    previewBox.classList.remove('d-none');
});

removeBtn.addEventListener('click', () => {
    input.value = '';                 // clear file
    previewImg.src = '';
    previewBox.classList.add('d-none');
});
</script>


{{/section}}
<!-- ========================== -->
<!-- views/product-ended.hbs -->
<!-- ========================== -->
<div class="card">
  <div class="card-body text-center py-5">
    <img src="{{product.image}}" alt="{{product.name}}" class="img-fluid mb-3" style="max-width: 300px;">
    <h3>{{product.name}}</h3>
    <p class="text-muted">Giá cuối: {{product.finalPrice}}</p>
    <div class="alert alert-info mt-4">
      <i class="bi bi-info-circle"></i> Sản phẩm đã kết thúc đấu giá
    </div>
    <p class="text-muted small">Kết thúc lúc: {{ product.endTime}}</p>
  </div>
</div>

<!-- ========================== -->
<!-- views/order-completion.hbs -->
<!-- ========================== -->
<div class="row">
  <!-- Thông tin sản phẩm -->
  <div class="col-12 mb-4">
    <div class="card">
      <div class="card-body">
        <div class="row align-items-center">
          <div class="col-md-2">
            <img src="{{product.image}}" alt="{{product.name}}" class="img-fluid rounded">
          </div>
          <div class="col-md-6">
            <h5 class="mb-1">{{product.name}}</h5>
            <p class="text-muted mb-0">Mã đơn: {{order.id}}</p>
          </div>
          <div class="col-md-4 text-end">
            <h4 class="text-primary mb-0">{{product.finalPrice}}</h4>
            <small class="text-muted">Kết thúc: {{product.endTime}}</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Thanh tiến trình -->
  <div class="col-12 mb-4">
    <div class="card">
      <div class="card-body">
        <h6 class="card-title mb-4">Tiến trình hoàn tất đơn hàng</h6>
        <div class="step-indicator">
          <div class="step {{#if (gte order.step 1)}}active{{/if}} {{#if (gte order.step 2)}}completed{{/if}}">
            <div class="step-circle">1</div>
            <div>Thanh toán</div>
          </div>
          <div class="step {{#if (gte order.step 2)}}active{{/if}} {{#if (gte order.step 3)}}completed{{/if}}">
            <div class="step-circle">2</div>
            <div>Vận chuyển</div>
          </div>
          <div class="step {{#if (gte order.step 3)}}active{{/if}} {{#if (gte order.step 4)}}completed{{/if}}">
            <div class="step-circle">3</div>
            <div>Nhận hàng</div>
          </div>
          <div class="step {{#if (gte order.step 4)}}active{{/if}}">
            <div class="step-circle">4</div>
            <div>Đánh giá</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Nội dung chính -->
  <div class="col-md-8">
    <div class="card mb-4">
      <div class="card-body">
        {{#if (eq order.step 1)}}
          {{#if isOrderBuyer}}
          <div>
            <h5 class="mb-4">
                <i class="bi bi-1-circle-fill text-primary"></i>
                Bước 1: Cung cấp thông tin thanh toán
            </h5>

            <form id="paymentForm"
                    action="/api/order/{{order.id}}/payment"
                    method="POST"
                    enctype="multipart/form-data">

                <!-- Chứng từ thanh toán -->
                <div class="mb-3">
                <label class="form-label">Chứng từ thanh toán *</label>
                <input type="file"
                    class="form-control"
                    id="paymentProof"
                    name="paymentProof"
                    accept="image/*"
                    required>

                <small class="text-muted">
                    Upload ảnh chuyển khoản hoặc biên lai thanh toán
                </small>


                <!-- preview ảnh mới -->
                <div id="paymentPreview" class="mt-2 d-none">
                    <img id="paymentPreviewImg"
                        class="img-thumbnail"
                        style="max-width:200px">

                    <button type="button"
                            class="btn btn-sm btn-outline-danger mt-2"
                            id="removePaymentImage">
                        Xoá ảnh
                    </button>
                </div>
                </div>

                <!-- Địa chỉ -->
                <div class="mb-3">
                <label class="form-label">Địa chỉ nhận hàng *</label>
                <textarea class="form-control"
                            name="address"
                            rows="2"
                            required>{{payment.address}}</textarea>
                </div>

                <!-- SĐT -->
                <div class="mb-3">
                <label class="form-label">Số điện thoại *</label>
                <input type="tel"
                        class="form-control"
                        name="phone"
                        value="{{payment.phone}}"
                        required>
                </div>

                <!-- Ghi chú -->
                <div class="mb-3">
                <label class="form-label">Ghi chú (không bắt buộc)</label>
                <textarea class="form-control"
                            name="notes"
                            rows="2">{{payment.notes}}</textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i>
                Gửi thông tin thanh toán
                </button>
            </form>
            </div>

            
          {{else}}
            <h5 class="mb-4"><i class="bi bi-1-circle-fill text-primary"></i> Bước 1: Đang chờ người mua thanh toán</h5>
            <div class="alert alert-info">
            <i class="bi bi-clock-history"></i> Đang chờ người mua gửi thông tin thanh toán và địa chỉ nhận hàng.
            </div>

            <div class="card bg-light">
            <div class="card-body">
                <h6>Thông tin người mua:</h6>
                <p class="mb-1"><strong>{{buyer.name}}</strong></p>
                <p class="mb-1">Đánh giá: ★ {{buyer.rating}}</p>
                <p class="mb-0 text-muted small">{{buyer.totalTransactions}} lượt đánh giá</p>
            </div>
            </div>

          {{/if}}
        {{/if}}

        {{#if (eq order.step 2)}}
          {{#if isOrderSeller}}
            <h5 class="mb-4"><i class="bi bi-2-circle-fill text-primary"></i> Bước 2: Xác nhận thanh toán và gửi hàng</h5>

            <div class="alert alert-success mb-3">
            <i class="bi bi-check-circle"></i> Người mua đã gửi thông tin thanh toán
            </div>

            {{#if order.paymentProof}}
            <div class="mb-3">
            <label class="form-label">Chứng từ thanh toán:</label>
            <div>
                <img src="{{order.paymentProof}}" alt="Payment proof" class="img-fluid rounded" style="max-width: 300px;">
            </div>
            </div>
            {{/if}}

            {{#if order.shippingAddress}}
            <div class="card bg-light mb-3">
            <div class="card-body">
                <h6>Địa chỉ giao hàng:</h6>
                <p class="mb-1">{{order.shippingAddress.address}}</p>
                <p class="mb-1">SĐT: {{order.shippingAddress.phone}}</p>
                {{#if order.shippingAddress.notes}}
                <p class="mb-0 text-muted small">Ghi chú: {{order.shippingAddress.notes}}</p>
                {{/if}}
            </div>
            </div>
            {{/if}}

            <hr>
            <form id="shippingForm" onsubmit="submitShipping(event)">
            <div class="mb-3">
                <label class="form-label">Đơn vị vận chuyển *</label>
                <select class="form-select" id="carrier" required>
                <option value="">Chọn đơn vị vận chuyển</option>
                <option value="ghn">Giao Hàng Nhanh</option>
                <option value="ghtk">Giao Hàng Tiết Kiệm</option>
                <option value="vnpost">VNPost</option>
                <option value="jnt">J&T Express</option>
                <option value="other">Khác</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Mã vận đơn *</label>
                <input type="text" class="form-control" id="trackingNumber" placeholder="Nhập mã vận đơn" required>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-truck"></i> Xác nhận đã gửi hàng
            </button>
            </form>
          {{else}}
            {{> step2-buyer}}
          {{/if}}
        {{/if}}

        {{#if (eq order.step 3)}}
          {{#if isOrderBuyer}}
            {{> step3-buyer}}
          {{else}}
            {{> step3-seller}}
          {{/if}}
        {{/if}}

        {{#if (eq order.step 4)}}
          {{> step4-rating isOrderBuyer=isOrderBuyer isOrderSeller=isOrderSeller order=order}}
        {{/if}}
      </div>
    </div>

    {{#if isOrderSeller}}
    <div class="card border-danger">
      <div class="card-body">
        <h6 class="card-title text-danger">Huỷ giao dịch</h6>
        <p class="small text-muted">Bạn có thể huỷ giao dịch nếu người mua không đáp ứng yêu cầu</p>
        <button class="btn btn-danger btn-sm" onclick="cancelOrder()">
          <i class="bi bi-x-circle"></i> Huỷ giao dịch
        </button>
      </div>
    </div>
    {{/if}}
  </div>

  <!-- Chat box -->
  <div class="col-md-4">
    <div class="card">
      <div class="card-header bg-primary text-white">
        <i class="bi bi-chat-dots"></i> Trò chuyện với {{#if isOrderBuyer}}người bán{{else}}người mua{{/if}}
      </div>
      <div class="card-body p-0">
        <div class="chat-box" id="chatBox">
          {{#each messages}}
          <div class="message {{sender}}">
            <div class="message-bubble">
              <div>{{content}}</div>
              <small class="text-muted" style="font-size: 0.75rem;">{{ time}}</small>
            </div>
          </div>
          {{/each}}
        </div>
        <div class="p-3 border-top">
          <form id="chatForm" onsubmit="sendMessage(event)">
            <div class="input-group">
              <input type="text" class="form-control" id="messageInput" placeholder="Nhập tin nhắn..." required>
              <button class="btn btn-primary" type="submit">
                <i class="bi bi-send"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Thông tin bên kia -->
    <div class="card mt-3">
      <div class="card-body">
        <h6 class="card-title">{{#if isOrderBuyer}}Người bán{{else}}Người mua{{/if}}</h6>
        <p class="mb-1"><strong>{{#if isOrderBuyer}}{{seller.name}}{{else}}{{buyer.name}}{{/if}}</strong></p>
        <div class="rating-stars mb-1">
          {{#if isOrderBuyer}}
            ★ {{seller.rating}}
          {{else}}
            ★ {{buyer.rating}}
          {{/if}}
        </div>
        <small class="text-muted">
          {{#if isOrderBuyer}}
            {{seller.totalTransactions}} giao dịch
          {{else}}
            {{buyer.totalTransactions}} giao dịch
          {{/if}}
        </small>
      </div>
    </div>
  </div>
</div>

