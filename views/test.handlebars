<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Management - Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f5f5;
        }
        
        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 240px;
            background: #fff;
            border-right: 1px solid #e0e0e0;
            padding: 0;
            z-index: 1000;
            overflow-y: auto;
        }
        
        .sidebar-header {
            padding: 1.5rem 1rem;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .sidebar-header h5 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
        }
        
        .sidebar-menu {
            padding: 1rem 0;
        }
        
        .menu-item {
            display: flex;
            align-items: center;
            padding: 0.65rem 1rem;
            color: #666;
            text-decoration: none;
            transition: all 0.2s;
        }
        
        .menu-item:hover {
            background: #f8f9fa;
            color: #333;
        }
        
        .menu-item.active {
            background: #e3f2fd;
            color: #1976d2;
            font-weight: 500;
        }
        
        .menu-item i {
            width: 20px;
            margin-right: 0.75rem;
            font-size: 1rem;
        }
        
        /* Main Content */
        .main-content {
            margin-left: 240px;
            padding: 2rem;
            min-height: 100vh;
        }
        
        /* Mobile */
        @media (max-width: 768px) {
            .sidebar {
                left: -240px;
            }
            
            .sidebar.show {
                left: 0;
                box-shadow: 2px 0 8px rgba(0,0,0,0.1);
            }
            
            .main-content {
                margin-left: 0;
            }
            
            .sidebar-toggle {
                display: block !important;
            }
        }
        
        .sidebar-toggle {
            display: none;
            position: fixed;
            top: 1rem;
            left: 1rem;
            z-index: 1001;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 0.25rem;
            padding: 0.5rem 0.75rem;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h5>Admin Panel</h5>
        </div>
        
        <div class="sidebar-menu">
            <a href="/admin" class="menu-item">
                <i class="bi bi-house"></i>
                <span>Dashboard</span>
            </a>
            
            <a href="/admin/products" class="menu-item">
                <i class="bi bi-box"></i>
                <span>Products</span>
            </a>
            
            <a href="/admin/categories" class="menu-item active">
                <i class="bi bi-grid"></i>
                <span>Categories</span>
            </a>
            
            <a href="/admin/orders" class="menu-item">
                <i class="bi bi-cart"></i>
                <span>Orders</span>
            </a>
            
            <a href="/admin/customers" class="menu-item">
                <i class="bi bi-people"></i>
                <span>Customers</span>
            </a>
            
            <a href="/admin/settings" class="menu-item">
                <i class="bi bi-gear"></i>
                <span>Settings</span>
            </a>
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h4 mb-1">Category Management</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                        <li class="breadcrumb-item active">Categories</li>
                    </ol>
                </nav>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                <i class="bi bi-plus-circle"></i> Add Category
            </button>
        </div>

        <!-- Filter & Search -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" class="form-control" placeholder="Search categories..." id="searchInput">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="levelFilter">
                            <option value="">All Levels</option>
                            <option value="parent">Parent Categories</option>
                            <option value="child">Sub Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Filter
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categories Table -->
        <div class="card">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="m-0">Category List</h6>
                    <span class="text-muted">Total: <strong id="totalCategories">8</strong></span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Category Name</th>
                                <th>Level</th>
                                <th>Parent</th>
                                <th>Products</th>
                                <th>Icon</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>
                                    <strong>Electronics</strong>
                                    <br>
                                    <small class="text-muted">electronics</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary">Parent</span>
                                </td>
                                <td>—</td>
                                <td>
                                    <span class="badge bg-secondary">45</span>
                                </td>
                                <td>
                                    <i class="bi bi-laptop fs-5"></i>
                                </td>
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" onclick="viewCategory(1)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" onclick="editCategory(1)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" disabled>
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>
                                    <strong>Laptops</strong>
                                    <br>
                                    <small class="text-muted">laptops</small>
                                </td>
                                <td>
                                    <span class="badge bg-info">Sub</span>
                                </td>
                                <td>Electronics</td>
                                <td>
                                    <span class="badge bg-secondary">28</span>
                                </td>
                                <td>
                                    <i class="bi bi-laptop fs-5"></i>
                                </td>
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" onclick="viewCategory(2)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" onclick="editCategory(2)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form action="/admin/categories/delete/1"
                                            method="post"
                                            style="display:inline;"
                                            onsubmit="return confirm('Bạn có chắc muốn xóa?')">

                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>
                                    <strong>Fashion</strong>
                                    <br>
                                    <small class="text-muted">fashion</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary">Parent</span>
                                </td>
                                <td>—</td>
                                <td>
                                    <span class="badge bg-secondary">120</span>
                                </td>
                                <td>
                                    <i class="bi bi-bag fs-5"></i>
                                </td>
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" onclick="viewCategory(3)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" onclick="editCategory(3)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" disabled>
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Pagination -->
            <div class="card-footer bg-white">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Previous</a>
                        </li>
                        <li class="page-item active">
                            <a class="page-link" href="#">1</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">2</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">3</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Add Category Modal -->
    <div class="modal fade" id="addCategoryModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form>
                    <div class="modal-header">
                        <h5 class="modal-title">Add New Category</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Category Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Slug</label>
                            <input type="text" class="form-control">
                            <small class="text-muted">Auto-generated if empty</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Level</label>
                            <select class="form-select" id="categoryLevel" onchange="toggleParentSelect()">
                                <option value="parent">Parent Category</option>
                                <option value="child">Sub Category</option>
                            </select>
                        </div>

                        <div class="mb-3" id="parentCategoryDiv" style="display: none;">
                            <label class="form-label">Parent Category</label>
                            <select class="form-select">
                                <option value="">Select Parent</option>
                                <option value="1">Electronics</option>
                                <option value="3">Fashion</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Icon</label>
                            <input type="text" class="form-control" placeholder="laptop, bag...">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="2"></textarea>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActive" checked>
                            <label class="form-check-label" for="isActive">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Category Modal -->
    <div class="modal fade" id="editCategoryModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form>
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Category</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Category Name</label>
                            <input type="text" class="form-control" value="Electronics">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Slug</label>
                            <input type="text" class="form-control" value="electronics">
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" checked>
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- View Category Modal -->
    <div class="modal fade" id="viewCategoryModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Category Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Name:</strong> Electronics</p>
                    <p><strong>Slug:</strong> electronics</p>
                    <p><strong>Products:</strong> 45</p>
                    <p><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>

        function toggleParentSelect() {
            const level = document.getElementById('categoryLevel').value;
            const parentDiv = document.getElementById('parentCategoryDiv');
            parentDiv.style.display = level === 'child' ? 'block' : 'none';
        }

        function viewCategory(id) {
            const modal = new bootstrap.Modal(document.getElementById('viewCategoryModal'));
            modal.show();
        }

        function editCategory(id) {
            const modal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
            modal.show();
        }

        function deleteCategory(id) {
            if (confirm('Are you sure you want to delete this category?')) {
                console.log('Delete category:', id);
            }
        }
    </script>
</body>
</html>