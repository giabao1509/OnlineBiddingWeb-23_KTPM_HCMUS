<!-- ===== HERO ===== -->
<div class="row mb-5">
    <div class="col-12">
        <div class="card bg-primary text-white border-0 shadow-lg">
            <div class="card-body p-5 text-center">
                <h1 class="display-4 fw-bold mb-3">Welcome to AuctionHub</h1>
                <p class="lead mb-4">Vietnam's Leading Online Auction Platform</p>

                <div class="d-flex gap-3 justify-content-center flex-wrap">
                    <a href="/products" class="btn btn-light btn-lg">
                        <i class="bi bi-search"></i> Explore Auctions
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== TOP 5 ENDING SOON ===== -->
<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-4">
            <i class="bi bi-clock-history text-danger"></i> Top 5 Auctions Ending Soon
        </h2>
    </div>
</div>

<div class="row mb-5">
    {{#each endingSoon}}
    <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card border-0 h-100 shadow-sm hover-card">
            <div class="position-relative">
                <a href="/products/detail/{{this.auction_id}}" class="text-decoration-none">
                    <img src="{{this.image_url}}" class="card-img-top" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
                </a>
                {{#if this.isNew}}
                    <div class="position-absolute top-0 start-0 m-2">
                        <div class="card shadow-sm border-0 bg-danger text-white px-2 py-1">
                            <div class="d-flex align-items-center small fw-semibold">
                                <i class="bi bi-lightning-fill me-1"></i>
                                NEW
                            </div>
                        </div>
                    </div>
                {{/if}}
                <span class="badge bg-dark position-absolute top-0 end-0 m-2">
                    {{this.category_name}}
                </span>
            </div>
            <div class="card-body d-flex flex-column">
                <a href="/products/detail/{{this.auction_id}}" class="text-decoration-none">
                    <h6 class="card-title text-dark fw-bold mb-3" style="min-height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        {{this.name}}
                    </h6>
                </a>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">
                            <i class="bi bi-cash-stack me-1"></i> Current Price
                        </small>
                        <span class="text-success fw-bold">{{format_currency this.currentPrice}}</span>
                    </div>
                
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="bi bi-shop me-1"></i>Seller
                        </small>
                        <small class="text-danger fw-semibold">{{this.seller_name}}</small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        {{#if this.top_bidder_name}}
                        <small class="text-muted">
                            <i class="bi bi-trophy me-1"></i>Top Bidder
                        </small>
                        <small class="text-danger fw-semibold">{{this.top_bidder_name}}</small>
                        {{else}}
                        <small class="text-muted">
                            <i class="bi bi-trophy me-1"></i>Top Bidder
                        </small>
                        <small class="text-danger fw-semibold">No bids yet</small>
                        {{/if}}
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>Time Remaining:
                        </small>
                        <small class="text-danger fw-semibold">{{this.time_remaining}}</small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="bi bi-bar-chart me-1"></i>Total Bids:
                        </small>
                        <small class="text-danger fw-semibold">{{#if this.bid_count}} {{this.bid_count}} {{else}} 0 {{/if}}</small>
                    </div>
                </div>

                <div class="mt-auto d-grid gap-2">
                    <a href="/products/detail/{{this.auction_id}}" class="btn btn-outline-dark">
                        <i class="bi bi-eye me-1"></i> View Details
                    </a>
                    {{#if ../user}}
                    <form action="/products/add_to_watchlist/{{this.auction_id}}" method="POST">
                        <button type="submit" class="btn btn-outline-danger w-100 btn-watchlist">
                            <i class="bi bi-heart me-1"></i> Add to Watchlist
                        </button>
                    </form>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>

