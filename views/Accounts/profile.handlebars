<!-- Profile Page -->
<div class="container py-5">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="fw-bold mb-2">
        <i class="bi bi-person-circle me-2 text-dark"></i>My Profile
      </h2>
      <p class="text-secondary">Manage your account information and settings</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column - Profile Information -->
    <div class="col-lg-8">
      <!-- User Avatar & Rating Card -->
      <a href="/accounts/external_profile/{{user.id}}" class="text-decoration-none text-dark">
      <div class="card border-0 shadow-sm mb-4 avatar-card profile-hover-card">
        <div class="card-body p-4">
          <div class="d-flex align-items-center">
            <!-- Avatar -->
            <div id="avatar"
                class="rounded-circle text-white d-flex align-items-center justify-content-center me-4 flex-shrink-0 fw-bold"
                style="width: 100px; height: 100px; font-size: 2.5rem;">
            </div>

            <div class="flex-grow-1">
              <h2 class="fw-bold mb-3">{{user.full_name}}</h2>

              <div class="d-flex flex-wrap gap-3 align-items-center">
                <!-- Joined Date -->
                <div class="d-flex align-items-center text-muted">
                  <i class="bi bi-calendar-check me-2"></i>
                  <span>Joined {{user.created_at}}</span>
                </div>

                <!-- Rating Percentage -->
                <div class="d-flex align-items-center">
                  <i class="bi bi-star-fill me-1 {{#if (gte user.rating_percent 80)}}text-success{{else if (gte user.rating_percent 50)}}text-warning{{else}}text-danger{{/if}}"></i>
                  <span class="badge {{#if (gte user.rating_percent 80)}}bg-success{{else if (gte user.rating_percent 50)}}bg-warning{{else}}bg-danger{{/if}} rounded-pill px-3 py-2 fs-6">
                    {{user.rating_percent}}%
                  </span>
                  <span class="text-muted ms-2 small">({{user.total_reviews}} reviews)</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      </a>
      <!-- Profile Information Card -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-dark text-white border-0 py-3">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <i class="bi bi-person-badge me-2"></i>Profile Information
            </h5>
            <button class="btn btn-light btn-sm" id="editProfileBtn">
              <i class="bi bi-pencil me-1"></i> Edit
            </button>
          </div>
        </div>
        <div class="card-body p-4">
          <!-- Display Mode -->
          <div id="profileDisplay">
            <div class="row g-4 mb-4">
              <div class="col-md-6">
                <label class="text-muted small text-uppercase mb-2 d-block">Full Name</label>
                <div class="h5 mb-0 text-dark">{{user.full_name}}</div>
              </div>
              <div class="col-md-6">
                <label class="text-muted small text-uppercase mb-2 d-block">Email Address</label>
                <div class="h5 mb-0 text-dark">{{user.email}}</div>
              </div>
            </div>

            <hr class="my-4">

            <div class="row g-4">
              <div class="col-md-6">
                <label class="text-muted small text-uppercase mb-2 d-block">Member Since</label>
                <div class="text-dark">
                  <i class="bi bi-calendar-check me-2 text-muted"></i>{{user.created_at}}
                </div>
              </div>
              <div class="col-md-6">
                <label class="text-muted small text-uppercase mb-2 d-block">Account Status</label>
                <span class="badge bg-success rounded-pill px-3 py-2">
                  <i class="bi bi-check-circle me-1"></i>Active
                </span>
              </div>
            </div>
          </div>

          <!-- Edit Form (Hidden by default) -->
          <form id="profileForm" action="/profile/update" method="POST" style="display:none;">
            <div class="mb-4">
              <h6 class="text-dark mb-3">
                <i class="bi bi-person me-2"></i>Basic Information
              </h6>
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label fw-semibold">Full Name</label>
                  <input type="text" name="name" class="form-control" value="{{user.full_name}}" required>
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Email Address</label>
                  <input type="email" name="email" class="form-control" value="{{user.email}}" required>
                </div>
              </div>
            </div>

            <hr class="my-4">

            <div class="mb-4">
              <h6 class="text-dark mb-3">
                <i class="bi bi-shield-lock me-2"></i>Change Password
              </h6>
              
              <div class="alert alert-light border d-flex align-items-start mb-3">
                <i class="bi bi-info-circle text-primary me-2 mt-1"></i>
                <div>
                  <small><strong>Optional:</strong> Leave password fields blank if you don't want to change your password.</small>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label fw-semibold">Current Password</label>
                  <input type="password" name="oldPassword" class="form-control" placeholder="Enter your current password">
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">New Password</label>
                  <input type="password" name="newPassword" class="form-control" placeholder="Minimum 6 characters">
                  <small class="text-muted">Must be at least 6 characters long</small>
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Confirm New Password</label>
                  <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm your new password">
                </div>
              </div>
            </div>

            <div class="d-flex gap-2 mt-4">
              <button type="submit" class="btn btn-dark flex-grow-1">
                <i class="bi bi-save me-2"></i>Save Changes
              </button>
              <button type="button" class="btn btn-outline-secondary flex-grow-1" id="cancelEditBtn">
                <i class="bi bi-x-circle me-2"></i>Cancel
              </button>
            </div>
          </form>
        </div>
      </div>

      {{#if isBuyer}}
      <!-- Upgrade Request Card -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-warning bg-opacity-10 border-0 py-3">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">
              <i class="bi bi-arrow-up-circle me-2 text-warning"></i>Upgrade to Seller
            </h5>
            <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#upgradeModal" id="requestUpgradeBtn">
              <i class="bi bi-send me-1"></i>Request
            </button>
          </div>
        </div>
        <div class="card-body">
          <p class="mb-2 text-muted">Current upgrade request status:</p>
          <span id="upgradeRequestStatus" class="badge bg-secondary rounded-pill px-3 py-2">
            <i class="bi bi-clock me-1"></i>None
          </span>
        </div>
      </div>
      {{/if}}
    </div>

    <!-- Right Column - Account Statistics -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
        <div class="card-header bg-dark text-white border-0 py-3">
          <h5 class="mb-0">
            <i class="bi bi-bar-chart me-2"></i>Account Activity
          </h5>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <div class="list-group-item border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                  <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-hammer fs-4 text-primary"></i>
                  </div>
                </div>
                <div class="flex-grow-1 ms-3">
                  <small class="text-muted d-block mb-1">Active Bids</small>
                  <h4 class="mb-0 fw-bold">{{stats.activeBids}}</h4>
                </div>
              </div>
            </div>

            <div class="list-group-item border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                  <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-trophy fs-4 text-success"></i>
                  </div>
                </div>
                <div class="flex-grow-1 ms-3">
                  <small class="text-muted d-block mb-1">Won Auctions</small>
                  <h4 class="mb-0 fw-bold">{{stats.wonAuctions}}</h4>
                </div>
              </div>
            </div>

            <div class="list-group-item border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                  <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                    <i class="bi bi-heart-fill fs-4 text-danger"></i>
                  </div>
                </div>
                <div class="flex-grow-1 ms-3">
                  <small class="text-muted d-block mb-1">Watchlist Items</small>
                  <h4 class="mb-0 fw-bold">{{stats.watchlist}}</h4>
                </div>
              </div>
            </div>

            <div class="list-group-item border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                  <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-wallet2 fs-4 text-warning"></i>
                  </div>
                </div>
                <div class="flex-grow-1 ms-3">
                  <small class="text-muted d-block mb-1">Total Spent</small>
                  <h4 class="mb-0 fw-bold">{{stats.totalSpent}}</h4>
                  <small class="text-muted">Million VND</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Upgrade to Seller -->
<div class="modal fade" id="upgradeModal" tabindex="-1" aria-labelledby="upgradeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form action="/accounts/profile/upgrade_seller" method="POST" class="modal-content border-0 shadow">
      <div class="modal-header bg-warning bg-opacity-10 border-0">
        <h5 class="modal-title text-dark" id="upgradeModalLabel">
          <i class="bi bi-arrow-up-circle me-2 text-warning"></i>Upgrade to Seller
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-4">
        <div class="text-center mb-3">
          <i class="bi bi-shop fs-1 text-warning"></i>
        </div>
        <p class="text-center mb-0">Are you sure you want to request an upgrade to become a Seller?</p>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-circle me-2"></i>Cancel
        </button>
        <button type="submit" class="btn btn-warning">
          <i class="bi bi-send me-2"></i>Confirm Request
        </button>
      </div>
    </form>
  </div>
</div>

{{#section 'css'}}
<style>

  .form-control:focus {
    border-color: #212529;
    box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.15);
  }

  .btn-dark {
    background-color: #212529;
    border-color: #212529;
  }

  .btn-dark:hover {
    background-color: #000;
    border-color: #000;
  }

  .list-group-item {
    transition: background-color 0.2s ease;
  }

  .list-group-item:hover {
    background-color: #f8f9fa;
  }

  .rounded-circle {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Avatar glow effect */
  .profile-hover-card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .profile-hover-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }
</style>



{{/section}}

{{#section 'js'}}
<script>
  function stringToColor(str) {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      hash = str.charCodeAt(i) + ((hash << 5) - hash);
    }

    const hue = Math.abs(hash) % 360;
    return `hsl(${hue}, 65%, 50%)`;
  }

  function getInitial(name) {
    return name?.trim()?.charAt(0)?.toUpperCase() || '?';
  }

  const fullName = "{{sellerInfo.full_name}}";
  const avatar = document.getElementById('avatar');

  avatar.textContent = getInitial(fullName);
  avatar.style.backgroundColor = stringToColor(fullName);
</script>

<script>
  const editBtn = document.getElementById('editProfileBtn');
  const cancelBtn = document.getElementById('cancelEditBtn');
  const form = document.getElementById('profileForm');
  const display = document.getElementById('profileDisplay');

  editBtn.addEventListener('click', () => {
    form.style.display = 'block';
    display.style.display = 'none';
    editBtn.style.display = 'none';
  });

  cancelBtn.addEventListener('click', () => {
    form.style.display = 'none';
    display.style.display = 'block';
    editBtn.style.display = 'inline-block';
    form.reset();
  });

  form.addEventListener('submit', (e) => {
    const newPassword = form.querySelector('input[name="newPassword"]').value;
    const confirmPassword = form.querySelector('input[name="confirmPassword"]').value;
    const oldPassword = form.querySelector('input[name="oldPassword"]').value;

    if (newPassword || confirmPassword || oldPassword) {
      if (!oldPassword) {
        e.preventDefault();
        alert('Please enter your current password');
        return;
      }
      if (newPassword !== confirmPassword) {
        e.preventDefault();
        alert('New passwords do not match');
        return;
      }
      if (newPassword.length < 6) {
        e.preventDefault();
        alert('New password must be at least 6 characters long');
        return;
      }
    }
  });
</script>
{{/section}}