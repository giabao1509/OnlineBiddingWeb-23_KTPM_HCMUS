<!-- Dashboard Page -->
<div class="container py-5">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="fw-bold mb-2">
        <i class="bi bi-speedometer2 me-2 text-dark"></i>Dashboard
      </h2>
      <p class="text-secondary">Welcome back, {{user.name}}</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Main Content Area -->
    <div class="col-lg-9">
      <!-- Tabs Navigation -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white border-0">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <ul class="nav nav-tabs border-0 mb-0">
                <!-- Buyer Tabs -->
                <li class="nav-item">
                  <a class="nav-link {{#if (eq activeTab 'bidding')}}active{{/if}}"
                     href="/accounts/my_auctions?tab=bidding&page=1">
                    <i class="bi bi-hammer me-2"></i>Bidding
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link {{#if (eq activeTab 'won')}}active{{/if}}"
                     href="/accounts/my_auctions?tab=won&page=1">
                    <i class="bi bi-trophy me-2"></i>Won Auctions
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link {{#if (eq activeTab 'watchlist')}}active{{/if}}"
                     href="/accounts/my_auctions?tab=watchlist&page=1">
                    <i class="bi bi-heart-fill me-2"></i>Watchlist
                  </a>
                </li>
              {{#if isSellerUpdated}}
                <!-- Seller Tabs -->
                <li class="nav-item">
                  <a class="nav-link {{#if (eq activeTab 'active')}}active{{/if}}"
                     href="/accounts/my_auctions?tab=active&page=1">
                    <i class="bi bi-clock-history me-2"></i>Active Auctions
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link {{#if (eq activeTab 'sold')}}active{{/if}}"
                     href="/accounts/my_auctions?tab=sold&page=1">
                    <i class="bi bi-check-circle me-2"></i>Sold Items
                  </a>
                </li>
              {{/if}}
            </ul>
          </div>
        </div>
        
        <div class="card-body p-0">
                <!-- BUYER TABS CONTENT -->
                
                <!-- Bidding Tab -->
                {{#if (eq activeTab 'bidding')}}
                <div class="list-group list-group-flush">
                {{#each biddingItems}}
                <a href="/products/detail/{{this.auction_id}}" class="list-group-item list-group-item-action border-0 border-bottom p-3">
                    <div class="d-flex align-items-center">
                    <img src="{{this.image}}" class="rounded me-3 shadow-sm" style="width:80px; height:80px; object-fit:cover;" alt="{{this.name}}">
                    <div class="flex-grow-1">
                        <h6 class="mb-2 fw-bold text-dark">{{this.name}}</h6>
                        <div class="d-flex gap-3 small">
                        <div>
                            <span class="text-muted">Your bid:</span>
                            <span class="text-primary fw-bold ms-1">{{format_currency this.yourbid}}</span>
                        </div>
                        <div>
                            <span class="text-muted">Current:</span>
                            <span class="text-success fw-bold ms-1">{{format_currency this.currentBid}}</span>
                        </div>
                        </div>
                        <div class="mt-2">
                        {{#if this.isWinning}}
                        <span class="badge bg-success rounded-pill">
                            <i class="bi bi-trophy me-1"></i>Leading
                        </span>
                        {{else}}
                        <span class="badge bg-warning rounded-pill">
                            <i class="bi bi-exclamation-triangle me-1"></i>Outbid
                        </span>
                        {{/if}}
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted fs-5"></i>
                    </div>
                </a>
                {{else}}
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted opacity-50 d-block mb-3"></i>
                    <p class="text-muted mb-0">No active bids</p>
                </div>
                {{/each}}
                </div>
                
                {{#if biddingItems}}
                <div class="card-footer bg-white border-top py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Showing page {{currentPage}} of {{totalPages}}</small>
                    {{#if (gt totalPages 1)}}
                    <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=bidding&page={{prevPage}}">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        </li>
                        {{#each pages}}
                        <li class="page-item {{#if active}}active{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=bidding&page={{number}}">{{number}}</a>
                        </li>
                        {{/each}}
                        <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=bidding&page={{nextPage}}">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        </li>
                    </ul>
                    </nav>
                    {{/if}}
                </div>
                </div>
                {{/if}}
                {{/if}}

                <!-- Won Auctions Tab -->
                {{#if (eq activeTab 'won')}}
                <div class="list-group list-group-flush">
                {{#each wonAuctions}}
                <a href="/orders/{{this.order_id}}" class="list-group-item list-group-item-action border-0 border-bottom p-3">
                    <div class="d-flex align-items-center">
                    <img src="{{this.image_url}}" class="rounded me-3 shadow-sm" style="width:80px; height:80px; object-fit:cover;" alt="{{this.name}}">
                    <div class="flex-grow-1">
                        <h6 class="mb-2 fw-bold text-dark">{{this.name}}</h6>
                        <div class="d-flex align-items-center gap-2">
                        <span class="text-success fw-bold">{{format_currency this.current_price}}</span>

                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted fs-5"></i>
                    </div>
                </a>
                {{else}}
                <div class="text-center py-5">
                    <i class="bi bi-trophy fs-1 text-muted opacity-50 d-block mb-3"></i>
                    <p class="text-muted mb-0">No won auctions yet</p>
                </div>
                {{/each}}
                </div>

                {{#if wonAuctions}}
                <div class="card-footer bg-white border-top py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Showing page {{currentPage}} of {{totalPages}}</small>
                    {{#if (gt totalPages 1)}}
                    <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=won&page={{prevPage}}">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        </li>
                        {{#each pages}}
                        <li class="page-item {{#if active}}active{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=won&page={{number}}">{{number}}</a>
                        </li>
                        {{/each}}
                        <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=won&page={{nextPage}}">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        </li>
                    </ul>
                    </nav>
                    {{/if}}
                </div>
                </div>
                {{/if}}
                {{/if}}

                <!-- Watchlist Tab -->
                {{#if (eq activeTab 'watchlist')}}
                <div class="list-group list-group-flush">
                    {{#each watchlist}}
                    <div class="list-group-item border-0 border-bottom p-3 position-relative watchlist-item">
                        <a href="/products/detail/{{this.auction_id}}" class="text-decoration-none d-block">
                            <div class="d-flex align-items-center">
                                <img src="{{this.image_url}}" class="rounded me-3 shadow-sm" style="width:80px; height:80px; object-fit:cover;" alt="{{this.name}}">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 fw-bold text-dark">{{this.name}}</h6>
                                    <span class="text-success fw-bold">
                                        {{#if (gt current_price 0)}} 
                                            {{format_currency this.current_price}} 
                                        {{else}} 
                                            {{format_currency this.starting_price}} 
                                        {{/if}}
                                    </span>
                                    <div class="mt-2">
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>Ends: {{formatFullDate this.end_time}}
                                        </small>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted fs-5 me-3"></i>
                            </div>
                        </a>
                        <form method="POST" action="/products/remove_from_watchlist/{{this.auction_id}}" class="d-inline">
                            <input type="hidden" name="auction_id" value="{{this.auction_id}}">
                            <button
                            type="submit"
                            class="btn btn-sm btn-outline-danger remove-watchlist-btn position-absolute"
                            data-auction-id="{{this.auction_id}}"
                            title="Remove from watchlist"
                            style="top: 12px; right: 12px; width: 32px; height: 32px; padding: 0; border-radius: 50%;"
                            >
                            <i class="bi bi-trash"></i>
                            </button>
                        </form>

                        
                    </div>
                    {{else}}
                    <div class="text-center py-5">
                        <i class="bi bi-heart fs-1 text-muted opacity-50 d-block mb-3"></i>
                        <p class="text-muted mb-0">No favorite items</p>
                    </div>
                    {{/each}}
                </div>
                {{#if watchlist}}
                <div class="card-footer bg-white border-top py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">Showing page {{currentPage}} of {{totalPages}}</small>
                    {{#if (gt totalPages 1)}}
                    <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=watchlist&page={{prevPage}}">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        </li>
                        {{#each pages}}
                        <li class="page-item {{#if active}}active{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=watchlist&page={{number}}">{{number}}</a>
                        </li>
                        {{/each}}
                        <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                        <a class="page-link" href="/accounts/my_auctions?tab=watchlist&page={{nextPage}}">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        </li>
                    </ul>
                    </nav>
                    {{/if}}
                </div>
                </div>
                {{/if}}
                {{/if}}

            {{#if isSellerUpdated}}
            <!-- SELLER TABS CONTENT -->
            
            <!-- Active Auctions Tab -->
            {{#if (eq activeTab 'active')}}
            <div class="list-group list-group-flush">
              {{#each activeAuctions}}
              <a href="/products/detail/{{this.auction_id}}" class="list-group-item list-group-item-action border-0 border-bottom p-3">
                <div class="d-flex align-items-center">
                    <img src="{{this.image_url}}" class="rounded me-3 shadow-sm" style="width:80px; height:80px; object-fit:cover;" alt="{{this.name}}">
                    <div class="flex-grow-1">
                    <h6 class="mb-2 fw-bold text-dark">{{this.name}}</h6>
                    <div class="d-flex gap-3 small">
                      <div>
                        <span class="text-muted">Current Price:</span>
                        <span class="text-success fw-bold ms-1">{{#if (gt current_price 0)}} {{format_currency this.current_price}} {{else}} {{format_currency this.starting_price}} {{/if}}</span>
                      </div>
                      <div>
                        <span class="text-muted">Bids:</span>
                        <span class="fw-bold ms-1">{{this.total_bids}}</span>
                      </div>
                    </div>
                    <div class="mt-2">
                      <small class="text-muted">
                        <i class="bi bi-clock me-1"></i>Ends: {{formatFullDate this.end_time}}
                      </small>
                    </div>
                  </div>
                  <i class="bi bi-chevron-right text-muted fs-5"></i>
                </div>
              </a>
              {{else}}
              <div class="text-center py-5">
                <i class="bi bi-clock-history fs-1 text-muted opacity-50 d-block mb-3"></i>
                <p class="text-muted mb-0">No active auctions</p>
              </div>
              {{/each}}
            </div>

            
            {{#if activeAuctions}}
            <div class="card-footer bg-white border-top py-3">
              <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing page {{currentPage}} of {{totalPages}}</small>
                {{#if (gt totalPages 1)}}
                <nav>
                  <ul class="pagination pagination-sm mb-0">
                    <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                      <a class="page-link" href="/accounts/my_auctions?tab=active&page={{prevPage}}">
                        <i class="bi bi-chevron-left"></i>
                      </a>
                    </li>
                    {{#each pages}}
                    <li class="page-item {{#if active}}active{{/if}}">
                      <a class="page-link" href="/accounts/my_auctions?tab=active&page={{number}}">{{number}}</a>
                    </li>
                    {{/each}}
                    <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                      <a class="page-link" href="/accounts/my_auctions?tab=active&page={{nextPage}}">
                        <i class="bi bi-chevron-right"></i>
                      </a>
                    </li>
                  </ul>
                </nav>
                {{/if}}
              </div>
            </div>
            {{/if}}
            {{/if}}

            <!-- Sold Items Tab -->
            {{#if (eq activeTab 'sold')}}
            <div class="list-group list-group-flush">
              {{#each soldItems}}
              <a href="/products/detail/{{this.auction_id}}" class="list-group-item list-group-item-action border-0 border-bottom p-3">
                <div class="d-flex align-items-center">
                  <img src="{{this.image_url}}" class="rounded me-3 shadow-sm" style="width:80px; height:80px; object-fit:cover;" alt="{{this.name}}">
                  <div class="flex-grow-1">
                    <h6 class="mb-2 fw-bold text-dark">{{this.name}}</h6>
                    <div class="d-flex align-items-center gap-2">
                      <span class="text-success fw-bold">Sold for: {{format_currency this.current_price}}</span>
                    </div>
                    <div class="mt-2">
                      <small class="text-muted">
                        <i class="bi bi-person me-1"></i>Buyer: {{this.buyer_name}}
                      </small>
                    </div>
                  </div>
                  <i class="bi bi-chevron-right text-muted fs-5"></i>
                </div>
              </a>
              {{else}}
              <div class="text-center py-5">
                <i class="bi bi-check-circle fs-1 text-muted opacity-50 d-block mb-3"></i>
                <p class="text-muted mb-0">No sold items yet</p>
              </div>
              {{/each}}
            </div>

            {{#if soldItems}}
            <div class="card-footer bg-white border-top py-3">
              <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">Showing page {{currentPage}} of {{totalPages}}</small>
                {{#if (gt totalPages 1)}}
                <nav>
                  <ul class="pagination pagination-sm mb-0">
                    <li class="page-item {{#if isFirstPage}}disabled{{/if}}">
                      <a class="page-link" href="/accounts/my_auctions?tab=sold&page={{prevPage}}">
                        <i class="bi bi-chevron-left"></i>
                      </a>
                    </li>
                    {{#each pages}}
                    <li class="page-item {{#if active}}active{{/if}}">
                      <a class="page-link" href="/accounts/my_auctions?tab=sold&page={{number}}">{{number}}</a>
                    </li>
                    {{/each}}
                    <li class="page-item {{#if isLastPage}}disabled{{/if}}">
                      <a class="page-link" href="/accounts/my_auctions?tab=sold&page={{nextPage}}">
                        <i class="bi bi-chevron-right"></i>
                      </a>
                    </li>
                  </ul>
                </nav>
                {{/if}}
              </div>
            </div>
            {{/if}}
            {{/if}}
         {{/if}}
        </div>
      </div>
    </div>

    <!-- Right Sidebar -->
    <div class="col-lg-3">
      <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
        <div class="card-header bg-dark text-white border-0 py-3">
          <h6 class="mb-0">
            <i class="bi bi-lightning-fill me-2"></i>Quick Actions
          </h6>
        </div>
        <div class="card-body">
          
          <a href="/products" class="btn btn-outline-dark w-100 mb-3">
            <i class="bi bi-search me-2"></i>Browse Auctions
          </a>
          {{#if isSellerUpdated}}
          <a href="/seller/create_product" class="btn btn-outline-dark w-100 mb-3">
            <i class="bi bi-plus-circle me-2"></i>Create Auction
          </a>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</div>

{{#section 'css'}}
<style>
  .nav-tabs {
    flex-wrap: nowrap;
  }

  .card-header.bg-dark .nav-tabs .nav-link {
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
    border-bottom: 3px solid transparent;
    transition: all 0.3s ease;
    padding: 0.75rem 1.25rem;
    white-space: nowrap;
  }

  .card-header.bg-dark .nav-tabs .nav-link:hover {
    color: rgba(255, 255, 255, 0.75);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .card-header.bg-dark .nav-tabs .nav-link.active {
    color: #fff !important;
    background-color: rgba(255, 255, 255, 0.15);
    border-bottom: 3px solid #fff;
  }

  .list-group-item-action:hover {
    background-color: #f8f9fa;
  }

  .pagination {
    --bs-pagination-color: #212529;
    --bs-pagination-bg: #fff;
    --bs-pagination-border-color: #dee2e6;
    --bs-pagination-hover-color: #000;
    --bs-pagination-hover-bg: #f8f9fa;
    --bs-pagination-active-color: #fff;
    --bs-pagination-active-bg: #212529;
    --bs-pagination-active-border-color: #212529;
  }

  .pagination .page-item.active .page-link {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .card-header .d-flex {
      flex-direction: column;
      gap: 1rem;
    }
    
    .flex-grow-1 {
      max-width: 100% !important;
    }
  }
</style>

<style>
.watchlist-item {
    transition: background-color 0.2s ease;
}

.watchlist-item:hover {
    background-color: #f8f9fa;
}

.remove-watchlist-btn {
    opacity: 0;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.watchlist-item:hover .remove-watchlist-btn {
    opacity: 1;
}

.remove-watchlist-btn:hover {
    background-color: #dc3545;
    color: white;
    border-color: #dc3545;
    transform: scale(1.1);
}
</style>
{{/section}}
